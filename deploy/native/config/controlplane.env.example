# Copy to controlplane.env. Values are literal, without quotes, export, or variable expansion.
CP_LISTEN=127.0.0.1:8081
DATABASE_URL=postgres://rmt_app:REPLACE_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/rmt?sslmode=disable
GRANT_ISSUER_SEED=REPLACE_WITH_64_HEX_CHARACTERS
DIRECTIVE_SIGNING_SEED=REPLACE_WITH_A_SEPARATE_STABLE_64_HEX_SEED
# Upcoming fleet-directive release: immediate notification; without this, delivery waits for
# the agent's next registration. Authenticated with CP_DEVICE_IDENTITY_TOKEN below.
CP_SIGNALING_NOTIFY_URL=http://127.0.0.1:8080
TOTP_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_KEY
CP_SECURE_COOKIE=1
CP_SIGNALING_URL=wss://remote.example.com/ws
CP_PUBLIC_ORIGIN=https://remote.example.com
CP_DEVICE_IDENTITY_TOKEN=REPLACE_WITH_RANDOM_64_HEX_TOKEN
CP_PRESENCE_URL=http://127.0.0.1:8080/internal/presence
CP_PRESENCE_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_TOKEN
CP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
CP_INSECURE_DEV=
CP_INSECURE_DEV_LISTEN_ANY=
CP_INSECURE_ALLOW_PRIVILEGED_DB=
# Upcoming recording release: storage is enabled only when RECORDING_MASTER_KEY is set.
# Absolute, non-symlink data path OUTSIDE viewer/download; writable by the service identity.
# Linux: add ReadWritePaths in a controlplane systemd override before enabling storage.
# Windows MUST set RECORDING_DIR explicitly before setting RECORDING_MASTER_KEY; the Linux
# fallback /var/lib/deskrally/recordings is not a Windows installation path.
RECORDING_DIR=
RECORDING_MASTER_KEY=
RECORDING_MASTER_KEY_ID=
RECORDING_MASTER_KEY_PREVIOUS=
# Restore drills only; leave unset during ordinary operation.
RECORDING_RECONCILE_MODE=
# Restore drills only, with the line above: mark recordings lost even if most files are missing (docs/22).
RECORDING_RECONCILE_ACCEPT_MISSING=
# Disk floor in whole MiB, 512..1048576 (empty = 5120 = 5 GiB). The recordings volume often shares the root
# filesystem with Postgres, so keep it generous. An invalid value stops startup.
RECORDING_DISK_FLOOR_MIB=
