    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.6.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
