# web/viewer production build-time configuration (Vite bakes VITE_* at build time).
#
# Copy to `.env.production` for a real deployment, or pass these as environment variables to
# `npm run build`. Everything here is PUBLIC — it ends up in the shipped bundle — so never put a
# secret in a VITE_ variable.

# The control-plane API base. Defaults to the same-origin `/cp` proxy prefix; leave unset for the
# standard reverse-proxy deployment (Caddy forwards /cp to the control plane).
# VITE_CONTROL_PLANE_URL=/cp

# The public product name shown on the guest /join page. Defaults to "DeskRally" when unset.
# The guest page is unauthenticated and cannot read GET /tenant/branding, so the name is baked here.
# VITE_PRODUCT_NAME=DeskRally

# REQUIRED for a production build (`npm run build` fails without it): the DEFAULT host's ORIGIN, e.g.
# https://remote.example.com (https, a dotted DNS host, optional port; NO path, query, fragment or userinfo). The
# "Remote support software by DeskRally" attribution on every tenant-branded join page links to this origin + "/docs"
# (docs/66 2a.7, 2i). It is never derived from the request host (a tenant host is attacker-influenced). A tenant-branded
# page is shown only with this link; if the value is invalid at runtime the join page is the neutral one.
# `none` is the explicit opt-out for a build without tenant branding (the generic release package): the build passes
# and every join page is neutral. publish-support-client.ps1 requires -DefaultOrigin (or this variable) for the rebuild.
VITE_DEFAULT_ORIGIN=https://remote.example.com

# --- Support-client download block (docs/27 step 18, docs/28 §4) ---
#
# LEAVE BOTH UNSET until `scripts/verify-download.ps1` has PASSED for this deployment. While unset,
# the /join page shows no download and points at the command-line path — the shipped page offers a
# guest nothing it cannot verify.
#
# The URL must be a SAME-ORIGIN ABSOLUTE PATH (one leading slash, no host, no scheme). Anything else
# is rejected by lib/support_download.ts and the block stays hidden, so a fat-fingered value cannot
# point guests at another host.
#
# `publish-support-client.ps1` (step 18) sets these from the artifact it just copied, so the served
# file and the baked hash cannot drift apart in two unlinked manual steps.
# VITE_SUPPORT_DOWNLOAD_URL=/download/DeskRallySupport.exe
# VITE_SUPPORT_DOWNLOAD_SHA256=<sha256 of the served DeskRallySupport.exe, from its .sha256.txt>
