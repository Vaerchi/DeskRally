// Resource file for DeskRally Client
// Embeds the application manifest and version info.
#include <winver.h>

// winuser.h does not compile under this build's rc include path (it pulls in
// stdarg.h), so the few dialog constants used below are defined here.
#define DS_SETFONT      0x40L
#define DS_MODALFRAME   0x80L
#define DS_CENTER       0x0800L
#define WS_POPUP        0x80000000L
#define WS_CAPTION      0x00C00000L
#define WS_SYSMENU      0x00080000L
#define ES_AUTOHSCROLL  0x0080L
#define IDOK            1
#define IDCANCEL        2

// Embed application manifest (ID 1 = application manifest)
1 RT_MANIFEST "client.manifest"
101 ICON "deskrally.ico"

// Organization prompt (client.cpp: IDD_ORGANIZATION, IDC_ORG_EDIT, IDC_ORG_ERROR).
200 DIALOGEX 0, 0, 280, 108
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DeskRally - Organization"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Enter your organization's DeskRally name. If you sign in at acme.<your DeskRally domain>, enter acme.", 203, 10, 10, 260, 20
    EDITTEXT        201, 10, 36, 260, 14, ES_AUTOHSCROLL
    LTEXT           "", 202, 10, 56, 260, 20
    DEFPUSHBUTTON   "Open", IDOK, 166, 84, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 84, 50, 14
END

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,8,4,0
PRODUCTVERSION 0,8,4,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DeskRally\0"
            VALUE "FileDescription",  "DeskRally Desktop Client\0"
            VALUE "FileVersion",      "0.8.4.0\0"
            VALUE "InternalName",     "DeskRallyClient\0"
            VALUE "LegalCopyright",   "Copyright DeskRally\0"
            VALUE "OriginalFilename", "DeskRallyClient.exe\0"
            VALUE "ProductName",      "DeskRally\0"
            VALUE "ProductVersion",   "0.8.4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
